@using AuthenticationAndAuthorization.Models

@{
    int count = CartStorage.CartItems.Sum(c => c.Quantity);
}
<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    
    <table class="table table-bordered">
        <tr>
            <td><img src="~/images/HarshitaLogo.png" width="120px"/></td>
            <td>
                <h2>Welcome to my website</h2>
            </td>
            <td>
                <a href="/Cart/Index" class="btn btn-warning">
                    🛒 Cart (@count)
                </a>
            </td>
        </tr>
        <tr>
            <td>
                <a href="/Product/Index1" class="btn btn-primary">Cosmetics</a><br /><br />
                <a href="/Product/Index2" class="btn btn-primary">Electronics</a><br /><br />
                <a href="/Product/Index3" class="btn btn-primary">Cloths</a><br /><br /><br />
                
            </td>
            <td>
                <div>
                    @RenderBody()
                </div>
            </td>
        </tr>
    </table>
    
</body>
</html>


<!-- have to make a add to cart functionality and add products in the cart with images
    and also give total price of the products to and + - to change the quantity

-->