{
    "Routes": [
        {
            "DownstreamPathTemplate": "/api/StudentAttendance",
            "DownstreamScheme": "http",
            "DownstreamHostAndPorts": [
                {
                    "Host": "localhost",
                    "Port": 5217
                }
            ],
            "UpstreamPathTemplate": "/apigateway/AttendanceService",
            "UpstreamHttpMethod": [ "GET"]
        },
        {
            "DownstreamPathTemplate": "/api/StudentAdmission",
            "DownstreamScheme": "http",
            "DownstreamHostAndPorts": [
                {
                    "Host": "localhost",
                    "Port": 5136
                }
            ],
            "UpstreamPathTemplate": "/apigateway/AdmissionService",
            "UpstreamHttpMethod": [ "GET" ]
        }
    ],
    "GlobalConfiguration": {
        "BaseUrl": "http://localhost:5051"
    }
}


//DownstreamPath template : path of the actual endpoint in microservice
//DownStreamScheme : http or https
//DownStreamHostAndPorts : host and port of the microservice
//UpstreamPathTemplate : path of the endpoint in API Gateway
//UpstreamHttpMethod : http method of the endpoint in API Gateway : get, post, put, delete


